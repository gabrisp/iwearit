# Copia a .env y rellena. `.env` está en .gitignore y no se sube nunca.
#
# La API key es SOLO para las herramientas que corren en tu Mac (convertir y
# subir modelos). La app nunca la ve: usa el project id público y lectura
# anónima sobre el bucket y la colección del manifiesto.
APPWRITE_ENDPOINT=https://appwrite.repzet.app/v1
APPWRITE_PROJECT_ID=iwearit
APPWRITE_API_KEY=

    "wkdesign.wktips.swipeRightOnWhatYou" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe right on what you like and left on what you don't: what you discard counts less in what comes next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra a la derecha lo que te guste y a la izquierda lo que no: lo que descartes pesa menos en lo que venga."
          }
        }
      }
    },

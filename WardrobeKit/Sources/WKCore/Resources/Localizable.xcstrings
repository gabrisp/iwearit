    "wkcore.stylistphrase.iDidnTGetWhat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I didn't get what you're after. Try a color, an occasion or a piece: «something blue for work», «no black», «with the white sneakers»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No he pillado lo que buscas. Prueba con un color, una ocasión o una prenda: «algo azul para el trabajo», «sin negro», «con las zapatillas blancas»."
          }
        }
      }
    },
    "wkcore.stylistphrase.iDidnTQuiteGet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I didn't quite get what you're after, but have a look at these."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No he pillado del todo lo que buscas, pero mira estos."
          }
        }
      }
    },
